---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — The Money Margin"
  description="Contact Daniel Reyes at The Money Margin. Have questions about a field guide or want to share your personal finance experience? Send a message."
>
  <article class="max-w-2xl mx-auto py-8 sm:py-12">
    <!-- Breadcrumb -->
    <div class="mb-8 font-sans">
      <div class="flex items-center gap-2 text-xs font-semibold text-[#5C6B7A] mb-4">
        <a href="/" class="hover:text-[#E67E22] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#E67E22] font-bold">Contact</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1A2B3C] font-sans tracking-tight">
        Contact
      </h1>
      <p class="font-serif text-lg text-[#5C6B7A] leading-relaxed mt-3">
        Have a question about one of my field guides, or want to share your own experience? I read every message.
      </p>
    </div>

    <!-- Contact Form Box -->
    <div class="p-6 sm:p-8 rounded-2xl bg-white border border-[#E8E2D9] shadow-sm font-sans mb-8">
      <form class="space-y-6" onsubmit="event.preventDefault(); alert('Thank you for reaching out! Your message draft has been simulated for this preview.');">
        <div>
          <label for="name" class="block text-xs uppercase tracking-wider font-bold text-[#1A2B3C] mb-2">
            Your Name
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="e.g. Alex Morgan"
            class="w-full px-4 py-3 rounded-lg border border-[#E8E2D9] bg-[#FAF8F5] text-[#1A2B3C] text-sm focus:outline-none focus:border-[#E67E22] focus:bg-white transition-colors"
          />
        </div>

        <div>
          <label for="email" class="block text-xs uppercase tracking-wider font-bold text-[#1A2B3C] mb-2">
            Your Email Address
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="e.g. alex@example.com"
            class="w-full px-4 py-3 rounded-lg border border-[#E8E2D9] bg-[#FAF8F5] text-[#1A2B3C] text-sm focus:outline-none focus:border-[#E67E22] focus:bg-white transition-colors"
          />
        </div>

        <div>
          <label for="message" class="block text-xs uppercase tracking-wider font-bold text-[#1A2B3C] mb-2">
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            placeholder="What's on your mind? Tell me about a card decision, budgeting question, or note on an article..."
            class="w-full px-4 py-3 rounded-lg border border-[#E8E2D9] bg-[#FAF8F5] text-[#1A2B3C] text-sm focus:outline-none focus:border-[#E67E22] focus:bg-white transition-colors font-serif resize-y"
          ></textarea>
        </div>

        <div>
          <button
            type="submit"
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3 rounded-md bg-[#1A2B3C] text-white font-bold text-sm hover:bg-[#E67E22] transition-colors shadow-sm cursor-pointer"
          >
            Send Message
          </button>
        </div>
      </form>
    </div>

    <!-- Direct Email & Response Time Callout -->
    <div class="p-6 rounded-xl bg-[#F3EFEA] border border-[#E8E2D9] font-sans text-sm space-y-3">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-[#E67E22] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        <div>
          <p class="font-bold text-[#1A2B3C]">Direct Email Option</p>
          <p class="text-[#5C6B7A] font-serif text-sm mt-0.5">
            You can also email me directly at <a href="mailto:wrwanshenchen@gmail.com" class="text-[#E67E22] font-semibold hover:underline font-mono">wrwanshenchen@gmail.com</a>.
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3 pt-2 border-t border-[#E8E2D9]/70">
        <svg class="w-5 h-5 text-[#5C6B7A] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
          <p class="text-xs text-[#5C6B7A] font-serif">
            I usually respond within 2-3 business days.
          </p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
