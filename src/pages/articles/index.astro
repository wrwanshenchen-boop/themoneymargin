---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="All Articles — The Money Margin"
  description="Complete archive of field-tested personal finance guides, credit repair methodologies, and budgeting routines by Daniel Reyes."
>
  <section class="py-8 sm:py-12 border-b border-[#E8E2D9]">
    <div class="max-w-3xl">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1A2B3C] font-sans tracking-tight mb-4">
        All Field Guides & Articles
      </h1>
      <p class="text-base sm:text-lg font-serif text-[#5C6B7A] leading-relaxed">
        Twelve unfiltered, first-person analyses of credit cards, debt payoff, expense tracking, and consumer finance traps. Organized chronologically by personal implementation order.
      </p>
    </div>
  </section>

  <section class="py-10">
    <div class="space-y-6">
      {sortedArticles.map((article) => {
        const formattedDate = new Intl.DateTimeFormat('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        }).format(article.data.pubDate);

        return (
          <article class="p-6 sm:p-8 rounded-lg bg-white border border-[#E8E2D9] hover:border-[#1A2B3C] transition-all hover:shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-sans text-[#5C6B7A] mb-3">
              <div class="flex items-center gap-2">
                <span class="font-bold px-2 py-0.5 rounded bg-[#F3EFEA] text-[#1A2B3C]">
                  {article.data.category}
                </span>
                <span>•</span>
                <span>Part {article.data.order} of 12</span>
              </div>
              <div class="flex items-center gap-3">
                <span>{formattedDate}</span>
                <span>•</span>
                <span>{article.data.readTime}</span>
              </div>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold font-sans text-[#1A2B3C] mb-3 hover:text-[#E67E22] transition-colors">
              <a href={`${base}/articles/${article.data.slug || article.slug}/`}>
                {article.data.title}
              </a>
            </h2>

            <p class="font-serif text-sm sm:text-base text-[#5C6B7A] leading-relaxed mb-6">
              {article.data.description}
            </p>

            <div class="flex items-center justify-between pt-4 border-t border-[#E8E2D9]/70 text-xs font-sans">
              <span class="text-[#728090]">Author: Daniel Reyes</span>
              <a
                href={`${base}/articles/${article.data.slug || article.slug}/`}
                class="font-bold text-[#1A2B3C] hover:text-[#E67E22] inline-flex items-center gap-1"
              >
                Read Field Guide &rarr;
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
